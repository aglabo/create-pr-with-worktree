##  General
#   OS specific files
.DS_Store
thumbs.db

#   logs, patches
*.log
*.diff
*.patch

#   history, cache
.history/
.cache/
**/*cache


#   backup/swap/temp
$~*
~*
*~
*tmp
*swp
*lock

# .env files
.env*
.env.*

# local tools
.tools/

## AI generated files

## Coding AI depended
# SDD (Spec-Driven Development) files
**/.cc-sdd/

# claude code setting
.claude/*

# agents can tracking
!.claude/agents/
!.claude/agents/**

# MCP server dependency files
.serena/
.lsmcp/

## Temporary directories are never tracked
temp/
tmp/
**/temp/
**/tmp/

## Development tools (installed locally)
.tools/

# pnpm
pnpm*lock.yaml

##  Editor
#   VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!.vscode/cspell*

## ShellSpec
# ShellSpec local configuration (user-specific overrides)
.shellspec-local

## Node
node_modules/
